# Accounted instance "dev" (Minisforum). Non-secret defaults only; secrets are Podman secrets.
# Precedence (Rule 07): process env, then the host override file
# ($XDG_CONFIG_HOME/accounted/instance.env), then this file.
# Port block 21230-21237, claimed in the services register (PRD 7.1).
ACCOUNTED_INSTANCE=dev
ACCOUNTED_USER=accounted-dev
ACCOUNTED_PORT_BASE=21230
ACCOUNTED_EDGE_PORT=21230
ACCOUNTED_STUDIO_PORT=21231
ACCOUNTED_DB_ADMIN_PORT=21232
ACCOUNTED_BIND_HOST=127.0.0.1
ACCOUNTED_ROAD=none
# The origin a browser uses (also the Supabase URL, single origin). Override on the host for a tailnet road.
ACCOUNTED_PUBLIC_URL=http://127.0.0.1:21230
ACCOUNTED_DATA_PROFILE=supabase-self
ACCOUNTED_IMAGE=localhost/accounted:latest
ACCOUNTED_BACKUP_TARGET=
ACCOUNTED_EGRESS_PROXY=
