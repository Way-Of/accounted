# Accounted instance "qa" (Hostinger). Non-secret defaults only; secrets are Podman secrets.
# Precedence (Rule 07): process env, then the host override file
# ($XDG_CONFIG_HOME/accounted/instance.env), then this file.
# Port block 26791-26798, picked at random and checked free on Hostinger and the Minisforum 2026-11-18,
# claimed in the services register (PRD 7.1). A release proves itself here before staging.
ACCOUNTED_INSTANCE=qa
ACCOUNTED_USER=accounted-qa
ACCOUNTED_PORT_BASE=26791
ACCOUNTED_EDGE_PORT=26791
ACCOUNTED_STUDIO_PORT=26792
ACCOUNTED_DB_ADMIN_PORT=26793
ACCOUNTED_BIND_HOST=127.0.0.1
ACCOUNTED_ROAD=none
# The origin a browser uses (also the Supabase URL, single origin). Until the hostname and Cloudflare
# Access are decided this is the loopback door, reached with: ssh -L 26791:127.0.0.1:26791 hostinger
ACCOUNTED_PUBLIC_URL=http://127.0.0.1:26791
ACCOUNTED_DATA_PROFILE=supabase-self
ACCOUNTED_BRAND_NAME=Accounted QA
ACCOUNTED_IMAGE=localhost/accounted:latest
ACCOUNTED_CRON_IMAGE=localhost/accounted-cron:latest
# Backups (PQ-10): a directory owned by the instance user (empty: no backup units are installed).
ACCOUNTED_BACKUP_TARGET=
ACCOUNTED_BACKUP_KEEP_DAYS=14
ACCOUNTED_BACKUP_ON_CALENDAR=*-*-* 02:30:00 UTC
ACCOUNTED_EGRESS_PROXY=
