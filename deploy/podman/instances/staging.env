# Accounted instance "staging" (Hostinger). Non-secret defaults only; secrets are Podman secrets.
# Precedence (Rule 07): process env, then the host override file
# ($XDG_CONFIG_HOME/accounted/instance.env), then this file.
# Port block 26219-26226, claimed in the services register (PRD 7.1).
ACCOUNTED_INSTANCE=staging
ACCOUNTED_USER=accounted-staging
ACCOUNTED_PORT_BASE=26219
ACCOUNTED_EDGE_PORT=26219
ACCOUNTED_STUDIO_PORT=26220
ACCOUNTED_DB_ADMIN_PORT=26221
ACCOUNTED_BIND_HOST=127.0.0.1
ACCOUNTED_ROAD=none
# The origin a browser uses (also the Supabase URL, single origin). Until the hostname and Cloudflare
# Access are decided this is the loopback door, reached with: ssh -L 26219:127.0.0.1:26219 hostinger
# The tunnel road changes it in the host override file; nothing in the image changes.
ACCOUNTED_PUBLIC_URL=http://127.0.0.1:26219
ACCOUNTED_DATA_PROFILE=supabase-self
ACCOUNTED_BRAND_NAME=Accounted Staging
ACCOUNTED_IMAGE=localhost/accounted:latest
ACCOUNTED_CRON_IMAGE=localhost/accounted-cron:latest
# Backups (PQ-10): a directory owned by the instance user (empty: no backup units are installed).
ACCOUNTED_BACKUP_TARGET=/srv/backups/accounted-staging
ACCOUNTED_BACKUP_KEEP_DAYS=14
ACCOUNTED_BACKUP_ON_CALENDAR=*-*-* 02:30:00 UTC
ACCOUNTED_EGRESS_PROXY=
