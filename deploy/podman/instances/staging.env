# Accounted instance "staging" (Hostinger). Non-secret defaults only; secrets are Podman secrets.
# Precedence (Rule 07): process env, then the host override file
# ($XDG_CONFIG_HOME/accounted/instance.env), then this file.
# Port block 26219-26226, claimed in the services register (PRD 7.1).
ACCOUNTED_INSTANCE=staging
ACCOUNTED_USER=accounted-staging
ACCOUNTED_PORT_BASE=26219
ACCOUNTED_EDGE_PORT=26219
ACCOUNTED_STUDIO_PORT=26220
ACCOUNTED_DB_ADMIN_PORT=26221
ACCOUNTED_BIND_HOST=127.0.0.1
ACCOUNTED_ROAD=tunnel
# Set on the host: the public origin the tunnel serves (also the Supabase URL, single origin).
ACCOUNTED_PUBLIC_URL=
ACCOUNTED_DATA_PROFILE=supabase-self
ACCOUNTED_IMAGE=localhost/accounted:latest
ACCOUNTED_BACKUP_TARGET=
ACCOUNTED_EGRESS_PROXY=
