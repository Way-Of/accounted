# GoTrue. Sign-up is closed: accounts come from invites and the admin API (AUTH_SIGNUPS_DISABLED on
# the app). No SMTP until a supplied accounted-smtp-password and a sender exist.
[Unit]
Description=Accounted ${ACCOUNTED_INSTANCE}: auth (GoTrue)
Requires=accounted-db.service
After=accounted-db.service

[Container]
ContainerName=accounted-auth
Image=${ACCOUNTED_IMG_AUTH}
Network=accounted.network
NetworkAlias=auth
Label=accounted.instance=${ACCOUNTED_INSTANCE}
Secret=accounted-postgres-password,type=env,target=PGPASSWORD
Secret=accounted-jwt-secret,type=env,target=GOTRUE_JWT_SECRET
Environment=GOTRUE_API_HOST=0.0.0.0
Environment=GOTRUE_API_PORT=9999
Environment=API_EXTERNAL_URL=${ACCOUNTED_PUBLIC_URL}/auth/v1
Environment=GOTRUE_DB_DRIVER=postgres
Environment=GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin@db:5432/postgres
Environment=GOTRUE_SITE_URL=${ACCOUNTED_PUBLIC_URL}
Environment=GOTRUE_URI_ALLOW_LIST=${ACCOUNTED_PUBLIC_URL}/auth/callback,${ACCOUNTED_PUBLIC_URL}/api/auth/callback,${ACCOUNTED_PUBLIC_URL}/auth/email-change
Environment=GOTRUE_DISABLE_SIGNUP=true
Environment=GOTRUE_JWT_ADMIN_ROLES=service_role
Environment=GOTRUE_JWT_AUD=authenticated
Environment=GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
Environment=GOTRUE_JWT_EXP=3600
Environment=GOTRUE_JWT_ISSUER=${ACCOUNTED_PUBLIC_URL}/auth/v1
Environment=GOTRUE_EXTERNAL_EMAIL_ENABLED=true
Environment=GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
Environment=GOTRUE_MAILER_AUTOCONFIRM=false
Environment=GOTRUE_EXTERNAL_PHONE_ENABLED=false
Environment=GOTRUE_SMS_AUTOCONFIRM=false
Environment=GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
Environment=GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
Environment=GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
Environment=GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:9999/health
HealthInterval=5s
HealthRetries=10
HealthStartPeriod=20s
Notify=healthy
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
PodmanArgs=--memory=256m --pids-limit=200

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
