# Realtime. The tenant id is parsed from the host name, so the gateway rewrites Host to
# realtime-dev.supabase-realtime (upstream envoy config) and this alias answers it.
[Unit]
Description=Accounted ${ACCOUNTED_INSTANCE}: realtime
Requires=accounted-db.service
After=accounted-db.service

[Container]
ContainerName=accounted-realtime
Image=${ACCOUNTED_IMG_REALTIME}
Network=accounted.network
NetworkAlias=realtime-dev.supabase-realtime
NetworkAlias=realtime
Label=accounted.instance=${ACCOUNTED_INSTANCE}
Secret=accounted-postgres-password,type=env,target=DB_PASSWORD
Secret=accounted-jwt-secret,type=env,target=API_JWT_SECRET
Secret=accounted-jwt-secret,type=env,target=METRICS_JWT_SECRET
Secret=accounted-realtime-secret-key-base,type=env,target=SECRET_KEY_BASE
Secret=accounted-realtime-db-enc-key,type=env,target=DB_ENC_KEY
Environment=PORT=4000
Environment=DB_HOST=db
Environment=DB_PORT=5432
Environment=DB_USER=supabase_admin
Environment=DB_NAME=postgres
Environment="DB_AFTER_CONNECT_QUERY=SET search_path TO _realtime"
Environment="ERL_AFLAGS=-proto_dist inet_tcp"
Environment="DNS_NODES=''"
Environment=RLIMIT_NOFILE=10000
Environment=APP_NAME=realtime
Environment=SEED_SELF_HOST=true
Environment=RUN_JANITOR=true
Environment=DISABLE_HEALTHCHECK_LOGGING=true
NoNewPrivileges=true
PodmanArgs=--memory=512m --pids-limit=400

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
