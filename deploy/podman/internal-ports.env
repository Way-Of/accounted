# Ports inside accounted.network. Never published, so they keep their image defaults
# (PRD 7.1, Q10 decided 2026-11-17): each container has its own network namespace and
# cannot collide with the host. Units and the edge read them from here, nowhere else.
ACCOUNTED_INTERNAL_APP_PORT=3000
ACCOUNTED_INTERNAL_EDGE_PORT=8080
